{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nomad-hq.replit.app/api/:path*"
    },
    {
      "source": "/((?!images|assets|favicon\\.svg|robots\\.txt|opengraph\\.jpg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
